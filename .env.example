# All three are PUBLIC build-time values — Vite inlines anything VITE_*.
# Never put a service_role key here.
VITE_SUPABASE_URL=https://your-rates-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 'local' for sampleData.ts, 'supabase' for the real database.
# Containers and allocations remain local either way until their repos are migrated.
VITE_DATA_SOURCE=supabase
